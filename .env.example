# Core Banking MCP Server Configuration
# Copy this file to .env and update values before starting the server.
# .env is gitignored and must never be committed.

# Environment guard: must be 'mock' or 'sandbox'. Production is forbidden.
CORE_ENV=mock

# PostgreSQL database connection
POSTGRES_DB=corebanking
POSTGRES_USER=corebanking
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Unique per git worktree when running multiple stacks concurrently (Docker container
# names and host ports are global, not scoped per worktree). Keep DATABASE_URL's port
# in sync with POSTGRES_PORT below — it is read independently, not derived from it.
POSTGRES_CONTAINER_NAME=core-banking-postgres

# JDBC connection string (used by the application)
DATABASE_URL=jdbc:postgresql://localhost:5432/corebanking
