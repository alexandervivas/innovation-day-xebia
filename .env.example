# Core Banking MCP Server Configuration
# Copy this file to .env and update values before starting the server.
# .env is gitignored and must never be committed.

# Environment guard: must be 'mock' or 'sandbox'. Production is forbidden.
CORE_ENV=mock

# PostgreSQL database connection
POSTGRES_DB=corebanking
POSTGRES_USER=corebanking
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Running multiple worktrees at once? Each needs its own POSTGRES_PORT (e.g. 5433) matched in
# DATABASE_URL below — DbConfig.fromEnv() reads DATABASE_URL directly, not derived from the port.

# sbt does not auto-load this file: run `set -a && source .env && set +a` before `sbt` commands.

# JDBC connection string (used by the application)
DATABASE_URL=jdbc:postgresql://localhost:5432/corebanking
